{
	"schemaVersion": 1,
	"id": "slipway_packaged_check",
	"version": "1.0.0",
	"name": "Slipway packaged-jar check",
	"description": "Starts the release jar with the exact play-stack jars in production Minecraft and checks that every mixin applies and Slipway works.",
	"license": "Apache-2.0",
	"environment": "client",
	"entrypoints": {
		"preLaunch": [
			"dev.timstewart.slipway.packagedcheck.PackagedCheckPreLaunch"
		],
		"fabric-client-gametest": [
			"dev.timstewart.slipway.packagedcheck.PackagedJarCheck"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"slipway": "*",
		"fabric-client-gametest-api-v1": "*"
	},
	"mixins": [
		"slipway_packaged_check.mixins.json"
	]
}
